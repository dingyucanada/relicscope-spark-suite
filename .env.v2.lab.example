COMPOSE_PROJECT_NAME=relicscope-v2-lab
LAB_UID=
LAB_GID=
RELICSCOPE_LAB_GIT_COMMIT=
LAB_OFFLINE_MODE=true

LAB_HOSTNAME=spark-lab.local
LAB_BIND_IP=127.0.0.1
LAB_HTTPS_PORT=8444
LAB_HEALTH_TIMEOUT_SECONDS=1800

# Example candidate. Confirm the current NVIDIA/vLLM Spark recipe and license first.
LAB_MODEL_PROFILE=nemotron3-nano-omni
LAB_MODEL=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-NVFP4
LAB_MODEL_REVISION=
LAB_MAX_MODEL_LEN=32768
LAB_GPU_MEMORY_UTILIZATION=0.70
LAB_MAX_NUM_BATCHED_TOKENS=32768
LAB_VIDEO_FPS=2
LAB_VIDEO_MAX_FRAMES=128
# NVIDIA's current DGX Spark recipe for this exact model requires vLLM 0.20.0.
LAB_VLLM_IMAGE=vllm/vllm-openai:v0.20.0
LAB_CADDY_IMAGE=caddy:2.10.2-alpine

LAB_API_KEY_FILE=./secrets/lab_api_key
LAB_HF_CACHE_DIR=./runtime/lab-hf-cache
LAB_VLLM_CACHE_DIR=./runtime/lab-vllm-cache
LAB_CADDY_DATA_DIR=./runtime/lab-caddy/data
LAB_CADDY_CONFIG_DIR=./runtime/lab-caddy/config
