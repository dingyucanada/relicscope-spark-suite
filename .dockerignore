# Allowlist the only inputs used by Dockerfile. In particular, never send
# .env, secrets/, runtime databases, uploaded artifacts, or model caches to
# the build context.
*
!Dockerfile
!Dockerfile.vllm
!Dockerfile.embedding
!requirements.lock
!requirements-embedding.lock
!app/
!app/**
!embedding_server/
!embedding_server/**
!data/
!data/**
!scripts/
!scripts/import-reference-library.py
!scripts/build-reference-vector-index.py
!scripts/evaluate-reference-recognition.py
!scripts/seal-reference-calibration.py
!deploy/vllm-entrypoint.sh
