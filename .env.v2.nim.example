# RelicScope V2 — NVIDIA NIM on one DGX Spark.
# Copy to .env.v2.nim. Keep the real file, credentials and caches out of Git.
COMPOSE_PROJECT_NAME=relicscope-v2-nim
RELICSCOPE_SERVICE_VERSION=2.1.0
RELICSCOPE_RUNTIME_MODE=single-spark
RELICSCOPE_NODE_ID=spark-primary
RELICSCOPE_COMPUTE_NODE_ID=spark-primary
RELICSCOPE_GIT_COMMIT=unknown
APP_UID=1000
APP_GID=1000

# Android Scout reaches only this HTTPS endpoint.
SCOUT_HOSTNAME=scout.spark.local
SCOUT_BIND_IP=127.0.0.1
# private_lan requires a configured RFC1918 address present on this Spark.
# adb_reverse is the only mode in which preflight accepts a loopback bind.
SCOUT_TRANSPORT_MODE=private_lan
SCOUT_HTTPS_PORT=8443
V2_HEALTH_TIMEOUT_SECONDS=1800
RELICSCOPE_SCOUT_MAX_IMAGES_PER_JOB=8
RELICSCOPE_SCOUT_WORKER_POLL_SECONDS=2
RELICSCOPE_SCOUT_MODEL_MAX_ATTEMPTS=3
RELICSCOPE_SCOUT_MODEL_RETRY_BASE_SECONDS=5
RELICSCOPE_SCOUT_MIN_FREE_BYTES=21474836480
RELICSCOPE_SCOUT_MAX_OUTSTANDING_JOBS_PER_DEVICE=20

# Primary pilot: the NVIDIA DGX-Spark-only Qwen3.6 VLM NIM.
# v2-nim-list-profiles prints compatible IDs on the target Spark. Select and freeze one.
MODEL_PROFILE=qwen3.6-35b-a3b-nim-scout
VISION_MODEL=qwen/qwen3.6-35b-a3b
VISION_MODEL_SOURCE=qwen/qwen3.6-35b-a3b
# Compatibility field: for this NIM path it carries the immutable profile ID,
# not an upstream Hugging Face source revision.
VISION_MODEL_REVISION=
NIM_MODEL_PROFILE=
NIM_SERVED_MODEL_NAME=qwen/qwen3.6-35b-a3b
NIM_MAX_IMAGES_PER_PROMPT=8
NIM_MAX_VIDEOS_PER_PROMPT=0
MODEL_TIMEOUT_SECONDS=240

PYTHON_IMAGE=python:3.12.11-slim-bookworm
NIM_VLM_IMAGE=nvcr.io/nim/qwen/qwen3.6-35b-a3b:1.7.1-variant
CADDY_IMAGE=caddy:2.10.2-alpine
NIM_CACHE_DIR=./runtime/nim-cache
# Refuse a fresh online preparation unless this many bytes remain available.
NIM_PREPARE_MIN_FREE_BYTES=68719476736
# Refuse startup preflight when competing workloads leave less unified memory.
NIM_PREFLIGHT_MIN_AVAILABLE_MEMORY_BYTES=68719476736
RELICSCOPE_DATA_HOST_DIR=./runtime/v2-data
SERVICE_API_KEY_FILE=./secrets/service_api_key
CADDY_DATA_DIR=./runtime/caddy/data
CADDY_CONFIG_DIR=./runtime/caddy/config

# The runtime starts only from the prepared local cache. NGC credentials are never
# stored here and are never mounted during the offline service phase.
RELICSCOPE_OFFLINE_MODE=true
NIM_DISABLE_MODEL_DOWNLOAD=1
NIM_TELEMETRY_MODE=0
